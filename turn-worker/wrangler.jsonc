{
  "name": "public-games-turn",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ADMISSIONS", "class_name": "TurnAdmissions" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TurnAdmissions"] }
  ],
  "vars": {
    "GAME_ORIGIN": "https://chrisawad.github.io"
  },
  "ratelimits": [
    {
      "name": "CREDENTIAL_REQUESTS",
      "namespace_id": "72461",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
